{
  "name": "aplikacja-dietetyczna-backend",
  "version": "1.0.0",
  "description": "Backend dla aplikacji dietetycznej z integracją AI",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "init-db": "node src/database/init.js",
    "test-ai": "node test-ai.js",
    "frontend": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "frontend:install": "cd frontend && npm install",
    "start-all": "concurrently \"npm run dev\" \"npm run frontend\"",
    "setup": "npm install && npm run frontend:install && npm run init-db"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "form-data": "^4.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.0"
  },
  "optionalDependencies": {
    "@langchain/openai": "^0.0.1",
    "langchain": "^0.0.200"
  }
}